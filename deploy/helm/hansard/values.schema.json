{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hansard Helm values",
  "description": "Sovereign Microsoft Teams transcription. One multilingual ASR model serves both French and English.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "images",
    "asr",
    "models",
    "orchestrator",
    "worker",
    "secrets",
    "storage"
  ],
  "definitions": {
    "unitInterval": {
      "description": "A number in [0,1]. Helm's --set cannot produce a float, so a numeric string is accepted too and range-checked by pattern.",
      "type": [
        "number",
        "string"
      ],
      "minimum": 0.0,
      "maximum": 1.0,
      "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
    },
    "nonNegativeSeconds": {
      "description": "Seconds, >= 0. Accepts a numeric string because Helm's --set cannot produce a float.",
      "type": [
        "number",
        "string"
      ],
      "minimum": 0.0,
      "maximum": 600.0,
      "pattern": "^[0-9]{1,3}(\\.[0-9]+)?$"
    },
    "digest": {
      "type": "string",
      "description": "Empty, or an OCI digest. Set global.requireImageDigests to forbid the empty form.",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "tristate": {
      "description": "true = always emit, false = never emit, auto = emit only when the CRD exists.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "auto"
        }
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "not": {
            "required": [
              "cpu"
            ]
          },
          "description": "CPU limits are rejected on purpose: CFS throttling ruins realtime audio."
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "storageClass": {
          "type": "string"
        },
        "requireImageDigests": {
          "type": "boolean"
        },
        "customCA": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "namespaceOverride": {
      "type": "string",
      "maxLength": 63
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "$ref": "#/definitions/image"
        },
        "worker": {
          "$ref": "#/definitions/image"
        },
        "workerGpu": {
          "$ref": "#/definitions/image"
        },
        "bot": {
          "$ref": "#/definitions/image"
        },
        "modelsInit": {
          "$ref": "#/definitions/image"
        },
        "modelsArtifact": {
          "$ref": "#/definitions/image"
        },
        "oras": {
          "$ref": "#/definitions/image"
        },
        "s3cli": {
          "$ref": "#/definitions/image"
        },
        "redis": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orchestrator": {
          "$ref": "#/definitions/serviceAccount"
        },
        "worker": {
          "$ref": "#/definitions/serviceAccount"
        },
        "bot": {
          "allOf": [
            {
              "$ref": "#/definitions/serviceAccount"
            },
            {
              "properties": {
                "automountServiceAccountToken": {
                  "const": false,
                  "description": "The capture bot must never receive a Kubernetes API token."
                }
              }
            }
          ]
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "enum": [
            "CRITICAL",
            "ERROR",
            "WARNING",
            "INFO",
            "DEBUG"
          ]
        },
        "logFormat": {
          "enum": [
            "json",
            "console"
          ]
        },
        "maxConcurrentMeetings": {
          "type": "integer",
          "minimum": 1
        },
        "workerThreads": {
          "type": "integer",
          "minimum": 0
        },
        "workspace": {
          "type": "string",
          "pattern": "^/"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "asr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "compute"
      ],
      "properties": {
        "engine": {
          "enum": [
            "parakeet",
            "whisper",
            "qwen3",
            "ensemble",
            "null"
          ],
          "description": "Must match hansard.config.AsrEngine."
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "enum": [
            "none",
            "int8"
          ]
        },
        "compute": {
          "enum": [
            "auto",
            "gpu",
            "cpu",
            "both"
          ],
          "description": "auto resolves to cpu: Helm cannot see node GPU capacity at template time."
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1
        },
        "beamSize": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "enum": [
            "auto",
            "fr",
            "en",
            "bg",
            "cs",
            "da",
            "de",
            "el",
            "es",
            "et",
            "fi",
            "hr",
            "hu",
            "it",
            "lt",
            "lv",
            "mt",
            "nl",
            "pl",
            "pt",
            "ro",
            "ru",
            "sk",
            "sl",
            "sv",
            "uk"
          ],
          "description": "auto sends no language tag. Parakeet TDT 0.6b v3 is multilingual and handles a mixed French/English meeting in one pass."
        },
        "intraOpThreads": {
          "type": "integer",
          "minimum": 0
        },
        "interOpThreads": {
          "type": "integer",
          "minimum": 0
        },
        "fallbackEngine": {
          "enum": [
            "parakeet",
            "whisper",
            "qwen3",
            "ensemble",
            "null",
            ""
          ]
        },
        "fallbackModelId": {
          "type": "string"
        }
      }
    },
    "diarization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "sherpa",
            "spectral",
            "sortformer",
            "pyannote",
            "null"
          ]
        },
        "segmentationModel": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to models.mountPath."
        },
        "embeddingModel": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to models.mountPath. nemo_en_titanet_small.onnx measured 0.01% speaker confusion against 47% for CAM++; re-benchmark before changing."
        },
        "clusteringThreshold": {
          "allOf": [
            {
              "$ref": "#/definitions/unitInterval"
            }
          ],
          "description": "Cosine distance at which two clusters stop being the same speaker. Higher = fewer speakers. 0.95 is calibrated."
        },
        "minimumSpeakerSeconds": {
          "allOf": [
            {
              "$ref": "#/definitions/nonNegativeSeconds"
            }
          ],
          "description": "Clusters with less total speech than this are absorbed into their nearest neighbour."
        },
        "maxSpeakers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "minSpeakers": {
          "type": "integer",
          "minimum": 1
        },
        "clusterConsolidation": {
          "type": "boolean"
        },
        "mergeSimilarity": {
          "allOf": [
            {
              "$ref": "#/definitions/unitInterval"
            }
          ],
          "description": "Cosine distance at which two clusters stop being the same speaker. Higher = fewer speakers. 0.95 is calibrated."
        }
      }
    },
    "vad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "silero",
            "energy",
            "null"
          ]
        },
        "threshold": {
          "$ref": "#/definitions/unitInterval"
        }
      }
    },
    "minutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 1024
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256
        },
        "temperature": {
          "type": [
            "number",
            "string"
          ],
          "minimum": 0.0,
          "maximum": 2.0,
          "pattern": "^[0-2](\\.[0-9]+)?$"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "browser",
            "file",
            "null"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "announceRecording": {
          "type": "boolean"
        },
        "announcementText": {
          "type": "string"
        },
        "joinTimeoutSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "lobbyTimeoutSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "silenceTimeoutSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "aloneTimeoutSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "uiLocale": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mountPath"
      ],
      "properties": {
        "source": {
          "enum": [
            "initImage",
            "image",
            "oras",
            "s3",
            "pvc"
          ]
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "emptyDir": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "type": "string"
            },
            "medium": {
              "enum": [
                "",
                "Memory"
              ]
            }
          }
        },
        "oras": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string"
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            }
          }
        },
        "pvc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "create": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessMode": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany"
              ]
            }
          }
        },
        "verifyChecksums": {
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "accessMode": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany"
              ]
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "cpu": {
          "allOf": [
            {
              "$ref": "#/definitions/placement"
            },
            {
              "properties": {
                "replicaCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "resources": {
                  "$ref": "#/definitions/resources"
                }
              }
            }
          ]
        },
        "gpu": {
          "allOf": [
            {
              "$ref": "#/definitions/placement"
            },
            {
              "properties": {
                "replicaCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "resourceName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[a-z0-9]([-a-z0-9._]*[a-z0-9])?$",
                  "description": "nvidia.com/gpu, or nvidia.com/gpu.shared with time-slicing and renameByDefault."
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "resources": {
                  "$ref": "#/definitions/resources"
                }
              }
            }
          ]
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "hpa": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "keda": {
              "type": "object",
              "properties": {
                "enabled": {
                  "$ref": "#/definitions/tristate"
                },
                "minReplicaCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxReplicaCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "target": {
                  "enum": [
                    "cpu",
                    "gpu"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "consumerPrefix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bot": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMapKey": {
          "type": "string",
          "minLength": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "The bot must have time to leave the meeting and flush its last audio buffer."
        },
        "hostUsers": {
          "type": "boolean"
        },
        "shm": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": "string",
              "description": "tmpfs bytes are charged to the container memory limit. Budget shm + working set."
            }
          }
        },
        "chromium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "noSandbox": {
              "type": "boolean"
            },
            "disableDevShmUsage": {
              "type": "boolean"
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "accessMode": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany"
              ]
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "filesystem",
            "s3"
          ]
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "s3": {
          "type": "object",
          "properties": {
            "forcePathStyle": {
              "const": true,
              "description": "Nutanix Objects and every other on-prem S3 gateway require path-style addressing."
            },
            "region": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cosi": {
          "type": "object",
          "properties": {
            "enabled": {
              "$ref": "#/definitions/tristate"
            },
            "protocol": {
              "enum": [
                "S3",
                "Azure",
                "GCP"
              ]
            },
            "deletionPolicy": {
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "externalSecret": {
          "type": "object",
          "properties": {
            "enabled": {
              "$ref": "#/definitions/tristate"
            }
          }
        }
      },
      "description": "Exactly one source of truth for secrets.",
      "oneOf": [
        {
          "title": "chart-managed Secret",
          "properties": {
            "create": {
              "const": true
            },
            "existingSecret": {
              "const": ""
            },
            "externalSecret": {
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            }
          },
          "required": [
            "create"
          ]
        },
        {
          "title": "pre-existing Secret",
          "properties": {
            "create": {
              "const": false
            },
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "externalSecret": {
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            }
          },
          "required": [
            "create",
            "existingSecret"
          ]
        },
        {
          "title": "External Secrets Operator",
          "properties": {
            "create": {
              "const": false
            },
            "existingSecret": {
              "const": ""
            },
            "externalSecret": {
              "properties": {
                "enabled": {
                  "not": {
                    "const": false
                  }
                }
              },
              "required": [
                "enabled"
              ]
            }
          },
          "required": [
            "create",
            "externalSecret"
          ]
        }
      ]
    },
    "delivery": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem",
              "email",
              "webhook",
              "teams_chat"
            ]
          }
        },
