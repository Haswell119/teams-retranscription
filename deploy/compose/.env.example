# Copy to .env. Everything here is optional.
HANSARD_VERSION=0.1.0
HANSARD_API_PORT=8000
HANSARD_LOG_LEVEL=INFO

# ONNX Runtime threads per worker. Leave headroom on a laptop.
HANSARD_WORKER_THREADS=4
HANSARD_WORKER_REPLICAS=1

# Corporate TLS-inspecting proxy during `docker compose build`:
#   DOCKER_BUILDKIT=1 docker compose build \
#     --build-arg PIP_INDEX_URL=https://pypi.internal/simple
