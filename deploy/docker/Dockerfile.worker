# syntax=docker/dockerfile:1.7
#
# Hansard CPU worker: ASR + diarization on ONNX Runtime. No PyTorch, ever.
#
#   docker build -f deploy/docker/Dockerfile.worker -t hansard-worker:0.1.0 .

ARG PYTHON_VERSION=3.11
ARG BASE_IMAGE=python:${PYTHON_VERSION}-slim-bookworm

FROM ${BASE_IMAGE} AS builder

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL=
ARG PIP_TRUSTED_HOST=
ARG EXTRAS=asr-onnx,diarization,observability
# Packages the project's extras do not declare. Normally empty - sherpa-onnx
# ships in the `diarization` extra. Verify with `hansard doctor` in the image.
ARG EXTRA_PIP_PACKAGES=

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y build-essential \
    && rm -rf /var/lib/apt/lists/*


# Corporate TLS-inspecting proxies re-sign every certificate. Feed their CA in
# without ever weakening verification:
#   docker build --secret id=ca_bundle,src=/etc/ssl/certs/corporate-ca.crt ...
RUN --mount=type=secret,id=ca_bundle,required=false \
    if [ -s /run/secrets/ca_bundle ]; then \
        cp /run/secrets/ca_bundle /usr/local/share/ca-certificates/hansard-build-ca.crt \
        && update-ca-certificates \
        && { echo '[global]'; echo 'cert=/etc/ssl/certs/ca-certificates.crt'; } >> /etc/pip.conf; \
    fi

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install ".[${EXTRAS}]" ${EXTRA_PIP_PACKAGES} \
    && python -c "import importlib.util,sys; sys.exit('torch leaked into the CPU worker image; check the extras') if importlib.util.find_spec('torch') else None"

RUN find /opt/venv -name '__pycache__' -type d -prune -exec rm -rf {} + \
    && find /opt/venv -name '*.pyc' -delete \
    && find /opt/venv -name 'tests' -type d -prune -exec rm -rf {} + || true

FROM ${BASE_IMAGE} AS runtime

ARG HANSARD_UID=10001
ARG HANSARD_GID=10001
ARG VERSION=0.1.0
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="hansard-worker" \
      org.opencontainers.image.description="Hansard CPU transcription and diarization worker" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Haswell119/teams-retranscription" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        tini \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

RUN groupadd --gid ${HANSARD_GID} hansard \
    && useradd --uid ${HANSARD_UID} --gid ${HANSARD_GID} --home-dir /var/lib/hansard \
       --shell /usr/sbin/nologin --no-log-init hansard \
    && mkdir -p /var/lib/hansard /models \
    && chown -R ${HANSARD_UID}:${HANSARD_GID} /var/lib/hansard /models

COPY --from=builder --chown=root:root /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    HOME=/var/lib/hansard \
    HANSARD_RUNTIME__WORKSPACE=/var/lib/hansard \
    HANSARD_RUNTIME__MODELS_DIR=/models \
    HANSARD_RUNTIME__ALLOW_MODEL_DOWNLOADS=false \
    HANSARD_RUNTIME__TELEMETRY_ENABLED=false \
    HANSARD_ASR__DEVICE=cpu \
    HANSARD_DIARIZATION__DEVICE=cpu \
    HF_HOME=/models/.cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    OMP_NUM_THREADS=1 \
    HANSARD_VERSION=${VERSION}

USER ${HANSARD_UID}:${HANSARD_GID}
WORKDIR /var/lib/hansard
EXPOSE 9095

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import hansard.observability.metrics as m; raise SystemExit(0)"]

ENTRYPOINT ["/usr/bin/tini", "--", "hansard"]
CMD ["worker"]
