# syntax=docker/dockerfile:1.7
#
# Hansard model artifact.
#
# Three outputs, one download:
#
#   1. --target export   -> a plain host directory (BuildKit local exporter),
#                           which is what `oras push` publishes and what CI
#                           checksums.
#   2. --target artifact -> a FROM scratch OCI image whose entire filesystem is
#                           /models. Usable directly as a Kubernetes `image:`
#                           volume (models.source=image) and as the thing you
#                           mirror with `nkp push bundle` / `skopeo copy`.
#   3. --target copier   -> the same /models on a busybox base, so it can run
#                           as an init container that copies into an emptyDir
#                           on clusters without the ImageVolume feature gate.
#                           This is the chart default (models.source=initImage).
#
# See deploy/docker/README.md and deploy/docker/Makefile.
#
# Weights are downloaded HERE, at build time, and never at pod start. Every
# file is pinned by SHA-256 in deploy/docker/models.manifest, so the build is
# reproducible and the bundle is auditable. Attribution lives in
# deploy/docker/models.NOTICE and is copied into the artifact as /models/NOTICE.
#
# One ASR model covers BOTH French and English (Parakeet TDT 0.6b v3 is
# multilingual): no per-language bundle, no per-language worker pool.

ARG FETCH_IMAGE=debian:bookworm-slim
ARG BUSYBOX_IMAGE=busybox:1.36-glibc

FROM ${FETCH_IMAGE} AS fetch

# Point these at internal mirrors for air-gapped builds. Every URL in
# models.manifest starts with one of the two public prefixes they replace.
ARG HF_ENDPOINT=https://huggingface.co
ARG GITHUB_MIRROR=https://github.com

ENV HF_ENDPOINT=${HF_ENDPOINT} \
    GITHUB_MIRROR=${GITHUB_MIRROR} \
    DEBIAN_FRONTEND=noninteractive

# curl + bzip2 + coreutils only. No Python, no Hugging Face client, no token:
# every artifact is a plain HTTPS GET verified against a pinned SHA-256.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
        curl ca-certificates bzip2 tar \
    && rm -rf /var/lib/apt/lists/*

# Corporate TLS-inspecting proxies re-sign every certificate. Feed their CA in
# without ever weakening verification:
#   docker build --secret id=ca_bundle,src=/etc/ssl/certs/corporate-ca.crt ...
RUN --mount=type=secret,id=ca_bundle,required=false \
    if [ -s /run/secrets/ca_bundle ]; then \
        cp /run/secrets/ca_bundle /usr/local/share/ca-certificates/hansard-build-ca.crt \
        && update-ca-certificates; \
    fi

COPY deploy/docker/models.manifest /build/models.manifest
COPY deploy/docker/models.NOTICE   /build/models.NOTICE
COPY deploy/docker/fetch-models.sh /build/fetch-models.sh

RUN sh /build/fetch-models.sh /build/models.manifest /build/models.NOTICE /out/models

# --- 1. host directory ------------------------------------------------------
FROM scratch AS export
COPY --from=fetch /out/models /

# --- 2. FROM scratch OCI image (ImageVolume / mirroring) --------------------
FROM scratch AS artifact

ARG VERSION=0.1.0
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="hansard-models" \
      org.opencontainers.image.description="Hansard ASR/VAD/diarization ONNX weights (French + English from one model), build-time resolved" \
      org.opencontainers.image.licenses="CC-BY-4.0 AND MIT" \
      org.opencontainers.image.source="https://github.com/Haswell119/teams-retranscription" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      io.hansard.models.mountpath="/models"

COPY --from=fetch /out/models /models

# --- 3. init-container copier (chart default) -------------------------------
FROM ${BUSYBOX_IMAGE} AS copier

ARG VERSION=0.1.0
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="hansard-models-init" \
      org.opencontainers.image.description="Hansard model weights plus a shell that copies them into an emptyDir" \
      org.opencontainers.image.licenses="CC-BY-4.0 AND MIT" \
      org.opencontainers.image.source="https://github.com/Haswell119/teams-retranscription" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      io.hansard.models.mountpath="/models"

COPY --from=fetch /out/models /opt/hansard-models

USER 10001:10001
ENTRYPOINT ["/bin/sh", "-c"]
# The chown is a no-op under Kubernetes, where this runs as 10001 into an
# emptyDir the kubelet has already made writable. It matters under compose,
# where the target is a named volume Docker creates owned by root:root: the
# copy has to run as root, and the weights must not stay that way.
CMD ["set -eu; target=\"${HANSARD_MODELS_TARGET:-/models}\"; cp -R /opt/hansard-models/. \"$target/\"; cd \"$target\"; sha256sum -c SHA256SUMS >/dev/null; if [ \"$(id -u)\" = 0 ]; then chown -R 10001:10001 .; fi; echo 'model artifact verified'"]
