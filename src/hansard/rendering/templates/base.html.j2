<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="{{ generator }}">
<meta name="robots" content="noindex, nofollow">
<title>{{ document_title }}</title>
<style>
:root {
  color-scheme: light dark;
  --page-width: 54rem;
  --bg: #fbfbfd;
  --panel: #ffffff;
  --ink: #16181d;
  --ink-soft: #575d69;
  --line: #e2e5ea;
  --accent: #1d4ed8;
  --accent-soft: #e9eefc;
  --shadow: 0 1px 2px rgba(18, 20, 25, 0.06), 0 10px 24px rgba(18, 20, 25, 0.05);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1015;
    --panel: #151a21;
    --ink: #e7eaf0;
    --ink-soft: #a3acbb;
    --line: #262d38;
    --accent: #86a9ff;
    --accent-soft: #1b2333;
    --shadow: none;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.65;
  font-feature-settings: "kern" 1;
}
.page { max-width: var(--page-width); margin: 0 auto; padding: 2.75rem 1.25rem 4rem; }
.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--accent);
  color: #fff;
  padding: 0.6rem 1rem;
  border-radius: 0 0 0.5rem 0;
  z-index: 10;
}
.skip-link:focus { left: 0; }
a { color: var(--accent); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.25rem; }
.eyebrow {
  margin: 0 0 0.4rem;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--accent);
}
h1 { font-size: clamp(1.65rem, 1.2rem + 2vw, 2.35rem); line-height: 1.18; letter-spacing: -0.02em; margin: 0; }
h2 { font-size: 1.22rem; margin: 2.6rem 0 0.9rem; padding-bottom: 0.45rem; border-bottom: 1px solid var(--line); }
h3 { font-size: 1.02rem; margin: 1.6rem 0 0.35rem; }
p { margin: 0 0 0.85rem; }
ul, ol { margin: 0 0 0.9rem; padding-left: 1.25rem; }
li { margin: 0.25rem 0; }
.metadata {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
  gap: 0.9rem 1.5rem;
  margin: 1.4rem 0 0;
  padding: 1.1rem 1.3rem;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 0.85rem;
  box-shadow: var(--shadow);
}
.metadata dt {
  margin: 0;
  font-size: 0.71rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.metadata dd { margin: 0.15rem 0 0; }
.toc { margin: 2.2rem 0 0; }
.toc h2 { font-size: 0.74rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft); border: 0; margin: 0 0 0.5rem; padding: 0; }
.toc ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; padding: 0; margin: 0; }
.toc a {
  display: inline-block;
  padding: 0.25rem 0.7rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel);
  text-decoration: none;
  font-size: 0.84rem;
}
.timecode {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.82em;
  font-variant-numeric: tabular-nums;
  color: var(--ink-soft);
  white-space: nowrap;
}
.lede { font-size: 1.05rem; }
.empty { color: var(--ink-soft); font-style: italic; }
.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 0.85rem;
  background: var(--panel);
  box-shadow: var(--shadow);
}
table { width: 100%; border-collapse: collapse; font-size: 0.94rem; }
th, td { text-align: left; padding: 0.62rem 0.85rem; border-bottom: 1px solid var(--line); vertical-align: top; }
thead th {
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  background: var(--accent-soft);
  white-space: nowrap;
}
tbody tr:last-child td { border-bottom: 0; }
.decisions { list-style: decimal; padding-left: 1.3rem; }
.decisions li { margin: 0 0 1rem; }
.statement { margin: 0 0 0.2rem; font-weight: 600; }
.rationale, .sources { margin: 0; color: var(--ink-soft); font-size: 0.93rem; }
.label { font-weight: 600; color: var(--ink); }
.topic { margin: 0 0 1.6rem; }
.topic h3 { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: baseline; }
.questions { list-style: disc; }
.attribution { color: var(--ink-soft); font-style: italic; }
.share-cell { min-width: 9rem; }
.share-value { display: block; font-variant-numeric: tabular-nums; }
.bar-track { display: block; height: 0.42rem; margin-top: 0.3rem; border-radius: 999px; background: var(--accent-soft); }
.bar { display: block; height: 100%; min-width: 2px; border-radius: 999px; background: var(--accent); }
.turn { margin: 0 0 1.4rem; }
.turn-heading { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: baseline; margin: 0 0 0.15rem; }
.speaker { font-weight: 650; }
.turn p:last-child { margin: 0; }
.colophon { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.87rem; }
.colophon p { margin: 0 0 0.35rem; }
@media (max-width: 30rem) {
  .page { padding: 1.75rem 0.9rem 3rem; }
  th, td { padding: 0.5rem 0.6rem; }
}
@media print {
  :root {
    --bg: #ffffff;
    --panel: #ffffff;
    --ink: #000000;
    --ink-soft: #3a3a3a;
    --line: #b8bcc4;
    --accent: #000000;
    --accent-soft: #eeeeee;
    --shadow: none;
  }
  body { font-size: 10.5pt; line-height: 1.45; }
  .page { max-width: none; padding: 0; }
  .skip-link, .toc { display: none; }
  a { color: inherit; text-decoration: none; }
  h2 { break-after: avoid; }
  section, article, tr, li, .metadata { break-inside: avoid; }
  .table-wrap { overflow: visible; box-shadow: none; }
}
</style>
</head>
<body>
<a class="skip-link" href="#content">{{ labels.skip_to_content }}</a>
<div class="page">
<header class="masthead">
<p class="eyebrow">{{ document.subtitle }}</p>
<h1>{{ document.title }}</h1>
<dl class="metadata">
{% for entry in document.metadata %}
<div>
<dt>{{ entry.label }}</dt>
<dd>
{%- if entry.machine_value %}<time datetime="{{ entry.machine_value }}">{{ entry.value }}</time>
{%- else %}{{ entry.value }}{% endif -%}
</dd>
</div>
{% endfor %}
</dl>
{% block masthead_extra %}{% endblock %}
</header>
{% block content %}{% endblock %}
<footer class="colophon">
<p>{{ document.footer }}</p>
{% block colophon_extra %}{% endblock %}
</footer>
</div>
</body>
</html>
