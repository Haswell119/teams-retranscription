# Hansard configuration. Copy to .env and edit.
# Every setting is optional; these are the defaults worth knowing about.
# Full reference: docs/configuration.md

# ---- Where the models live. Never downloaded at run time by default. ----
HANSARD_RUNTIME__MODELS_DIR=/var/lib/hansard/models
HANSARD_RUNTIME__WORKSPACE=/var/lib/hansard
HANSARD_RUNTIME__ALLOW_MODEL_DOWNLOADS=false
HANSARD_RUNTIME__LOG_LEVEL=INFO
HANSARD_RUNTIME__LOG_FORMAT=json
HANSARD_RUNTIME__MAX_CONCURRENT_MEETINGS=2

# ---- Speech recognition. One model serves French and English. ----
HANSARD_ASR__ENGINE=parakeet
HANSARD_ASR__MODEL_ID=nemo-parakeet-tdt-0.6b-v3
HANSARD_ASR__QUANTIZATION=int8
HANSARD_ASR__DEVICE=auto
HANSARD_ASR__BATCH_SIZE=4
# Leave unset to let the model decide the language per meeting.
# HANSARD_ASR__LANGUAGE=fr

# ---- Speaker diarization. 0.99 is calibrated for the TitaNet embedding
# space; re-benchmark if you change EMBEDDING_MODEL. ----
HANSARD_DIARIZATION__ENGINE=sherpa
HANSARD_DIARIZATION__EMBEDDING_MODEL=nemo_en_titanet_small.onnx
HANSARD_DIARIZATION__CLUSTERING_THRESHOLD=0.99
HANSARD_DIARIZATION__MINIMUM_SPEAKER_SECONDS=3.0
HANSARD_DIARIZATION__MAX_SPEAKERS=8

# ---- Minutes. Point this at your own local model server. ----
HANSARD_MINUTES__ENABLED=true
HANSARD_MINUTES__ENDPOINT=http://localhost:8080/v1
HANSARD_MINUTES__MODEL_ID=qwen3-8b-instruct
# HANSARD_MINUTES__API_KEY=

# ---- The meeting bot. ----
HANSARD_CAPTURE__ENGINE=browser
HANSARD_CAPTURE__DISPLAY_NAME=Hansard Notetaker
HANSARD_CAPTURE__ANNOUNCE_RECORDING=true

# ---- Delivery. ----
HANSARD_DELIVERY__OUTPUT_DIR=artifacts
HANSARD_DELIVERY__SMTP__HOST=localhost
HANSARD_DELIVERY__SMTP__PORT=25
HANSARD_DELIVERY__SMTP__SENDER=hansard@localhost
# HANSARD_DELIVERY__SMTP__USERNAME=
# HANSARD_DELIVERY__SMTP__PASSWORD=
# HANSARD_DELIVERY__GRAPH__TENANT_ID=
# HANSARD_DELIVERY__GRAPH__CLIENT_ID=
# HANSARD_DELIVERY__GRAPH__CLIENT_SECRET=

# ---- HTTP API. ----
HANSARD_API__HOST=0.0.0.0
HANSARD_API__PORT=8000
# HANSARD_API__API_KEY=

# ---- Additional diarization tuning ----
HANSARD_DIARIZATION__CLUSTER_CONSOLIDATION=true
HANSARD_DIARIZATION__MERGE_SIMILARITY=0.60

# ---- Browser locale the selectors were written against ----
HANSARD_CAPTURE__UI_LOCALE=en-US

# ---- Webhook signing and body format ----
# HANSARD_DELIVERY__WEBHOOK_SECRET=
# HANSARD_DELIVERY__WEBHOOK_FORMAT=json
# HANSARD_DELIVERY__BOT_TENANT_ID=

# ---- Metrics ----
HANSARD_API__METRICS_ENABLED=true
HANSARD_API__METRICS_PATH=/metrics

# ---- Minutes engine: auto probes the endpoint, extractive needs no LLM ----
HANSARD_MINUTES__ENGINE=auto
